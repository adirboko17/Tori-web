NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# Server-only — never prefix these with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
APP_URL=http://127.0.0.1:3000
PAYPLUS_CALLBACK_URL=
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
PAYPLUS_SUBSCRIPTION_PAGE_UID=
PAYPLUS_TERMINAL_UID=
PAYPLUS_ENV=production

# Admin mobile app push notifications.
# ADMIN_PUSH_WEBHOOK_SECRET: at least 24 random chars; the same value goes in the
# Supabase Vault secret `admin_push_webhook_secret` (see supabase/migrations).
# EXPO_ACCESS_TOKEN: optional, only if "Enhanced push security" is on in Expo.
ADMIN_PUSH_WEBHOOK_SECRET=
EXPO_ACCESS_TOKEN=

# Marketing tags for wetori.co.il. Leave empty until the IDs exist.
# Scripts load only after the visitor accepts cookies. Do not set these on the booking apps.
# If NEXT_PUBLIC_GTM_ID is set, put Analytics and Ads inside that container and leave the other two empty.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GTM_ID=
